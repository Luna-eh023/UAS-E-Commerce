rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    match /faqs/{faqId} {
      allow read, write: if true;
    }
    match /helpMessages/{messageId} {
      allow read, write: if true;
    }

    // BARU: koleksi produk
    match /products/{productId} {
      allow read, write: if true;
    }
  }
}